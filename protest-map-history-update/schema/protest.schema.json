{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protest record",
  "type": "object",
  "required": ["id","title","start","end","date_label","scope","location","intensity","status","groups","topics","summary","background","status_text","sources","last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "start": {"type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"},
    "end": {"type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"},
    "date_label": {"type": "string", "description": "Human-readable dates, e.g. 'Oct 5–10, 2026'"},
    "scope": {"enum": ["local", "national"]},
    "location": {"type": "object", "required": ["name","lat","lon"],
      "properties": {"name": {"type": "string"}, "state": {"type": ["string","null"]},
                     "lat": {"type": "number"}, "lon": {"type": "number"}}},
    "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"enum": ["planned","ongoing","ended","unknown"]},
    "groups": {"type": "array", "minItems": 1,
      "items": {"enum": ["ruling","opposition","students","workers","farmers","environment","civil"]}},
    "topics": {"type": "string"},
    "summary": {"type": "string"},
    "background": {"type": "string", "description": "Why the protest started, in the organisers' terms"},
    "status_text": {"type": "string", "description": "What has happened, with dates"},
    "response": {"type": "string", "description": "The other side's position: authorities, company, rival party"},
    "sources": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["title","url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}}}},
    "needs_review": {"type": "boolean", "description": "Starter record not yet checked against primary sources"},
    "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
