{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Benz404/india_protests/blob/main/schema/protest.schema.json",
  "title": "India Protest Map record",
  "description": "A single curated protest record. Claims should be attributed to their sources.",
  "type": "object",
  "required": [
    "id", "title", "start", "end", "date_label", "scope", "location",
    "intensity", "status", "groups", "topics", "summary", "background",
    "status_text", "sources", "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "start": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "First active month, formatted YYYY-MM."
    },
    "end": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "Last active month, formatted YYYY-MM."
    },
    "date_label": {"type": "string", "minLength": 1},
    "scope": {"enum": ["local", "national"]},
    "location": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "state": {"type": ["string", "null"]},
        "lat": {"type": "number", "minimum": 6, "maximum": 38},
        "lon": {"type": "number", "minimum": 68, "maximum": 98}
      }
    },
    "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"enum": ["planned", "ongoing", "ended", "unknown"]},
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["ruling", "opposition", "students", "workers", "farmers", "environment", "civil"]
      }
    },
    "topics": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "background": {"type": "string", "minLength": 1},
    "status_text": {"type": "string", "minLength": 1},
    "response": {
      "type": "string",
      "description": "Other side's position, when found. Omit rather than guess."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {
            "type": "string",
            "minLength": 9,
            "pattern": "^https://"
          }
        }
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
